{
  "manifest_version": 3,
  "name": "Model Fleet + Approval Assistant",
  "version": "0.11.5",
  "description": "Per-tab ChatGPT workers with a concurrent control plane, natural-language peer messaging, and WASM-assisted approval automation.",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Model Fleet — current tab",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["stream-retry.js", "connector-attachment.js", "content.js", "connector-diagnostics.js", "connector-diagnostic-classifier.js", "fleet-worker.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["approval_hint_wasm.wasm"],
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"]
    }
  ]
}
