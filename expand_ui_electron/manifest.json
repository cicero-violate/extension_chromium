{
  "manifest_version": 3,
  "name": "Expand UI",
  "version": "1.1.0",
  "description": "Low-overhead UI width expansion with site-scoped declarative CSS",
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.chatgpt.com/*"
      ],
      "css": [
        "sites/chatgpt/style.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.perplexity.ai/*",
        "*://*.claude.ai/*",
        "*://*.gemini.google.com/*"
      ],
      "css": [
        "sites/shared/style.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.grok.com/*",
        "*://*.x.ai/*"
      ],
      "css": [
        "sites/grok/style.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*"
      ],
      "css": [
        "sites/x/style.css"
      ],
      "run_at": "document_start"
    }
  ]
}
