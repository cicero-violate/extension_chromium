{
  "manifest_version": 3,
  "name": "ChatGPT Suffix Injector",
  "version": "3.0",
  "description": "Appends a storage-backed suffix to outbound ChatGPT messages using a page-injected request hook.",
  "permissions": [
    "storage"
  ],
  "options_page": "options.html",
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "request_hook_private.js",
        "request_hook_group.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ]
    }
  ]
}
